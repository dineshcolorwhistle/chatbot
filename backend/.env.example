# ============================================
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# ============================================

# ----- LLM Provider -----
# Options: "ollama" (local) | "cloud" (OpenAI-compatible API)
LLM_PROVIDER=ollama

# ----- Ollama Local Configuration -----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ----- Cloud LLM Configuration -----
# For any OpenAI-compatible API (OpenAI, Groq, Together AI, etc.)
CLOUD_API_KEY=your-cloud-api-key-here
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-4o-mini

# ----- Application Settings -----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Pinecone RAG Configuration -----
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=colorwhistle-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=colorwhistle

# ----- Embedding Model (Ollama) -----
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# ----- Email Configuration -----
ADMIN_EMAILS=admin@colorwhistle.com,sales@colorwhistle.com

# ----- Daily Summary Scheduler -----
# Cron expression: minute hour day_of_month month day_of_week
# Default: "0 0 * * *" (midnight every day)
DAILY_SUMMARY_CRON=0 0 * * *
DAILY_SUMMARY_ENABLED=false
